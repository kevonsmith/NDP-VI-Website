<%- include('partials/header') %>
<section class="card section-card">
  <h1>Admin Dashboard</h1>
  <div class="grid-3">
    <div class="kpi"><strong><%= users.length %></strong><span>Members</span></div>
    <div class="kpi"><strong><%= users.filter(u => u.membership_status === 'active').length %></strong><span>Active</span></div>
    <div class="kpi"><strong>$<%= (payments.reduce((s,p)=>s+p.amount,0)/100).toFixed(2) %></strong><span>Revenue</span></div>
  </div>
</section>

<section class="grid-2">
  <div class="card section-card">
    <h2>Publish News</h2>
    <form method="post" action="/admin/news">
      <label>Title<input name="title" required /></label>
      <label>Slug<input name="slug" placeholder="optional-custom-slug" /></label>
      <label>Excerpt<textarea name="excerpt" required></textarea></label>
      <label>Body<textarea name="body" rows="6" required></textarea></label>
      <button class="btn" type="submit">Publish</button>
    </form>
  </div>
  <div class="card section-card">
    <h2>Upload Manifesto</h2>
    <form method="post" action="/manifesto" enctype="multipart/form-data">
      <label>Title<input name="title" value="Manifesto" /></label>
      <label>File<input name="manifesto" type="file" accept="application/pdf,image/png,image/jpeg" required /></label>
      <button class="btn" type="submit">Upload</button>
    </form>
  </div>
</section>


<section class="grid-2">
  <div class="card section-card">
    <h2>Add Party Leader</h2>
    <form method="post" action="/admin/leaders" enctype="multipart/form-data">
      <label>Role
        <select name="role" required>
          <option>President</option>
          <option>Vice President</option>
          <option>Chairman</option>
          <option>Deputy Chair</option>
        </select>
      </label>
      <label>Name<input name="name" required /></label>
      <label>Bio<textarea name="bio" rows="4" placeholder="Short leadership bio"></textarea></label>
      <label>Display Order<input name="display_order" type="number" value="0" /></label>
      <label>Photo<input name="photo" type="file" accept="image/png,image/jpeg" /></label>
      <button class="btn" type="submit">Add Leader</button>
    </form>
    <div class="compact-list">
      <% leaders.forEach(l => { %>
        <div><strong><%= l.role %>:</strong> <%= l.name %>
          <form method="post" action="/admin/leaders/<%= l.id %>/delete" class="inline-form"><button type="submit">Delete</button></form>
        </div>
      <% }) %>
    </div>
  </div>

  <div class="card section-card">
    <h2>Add Political Candidate</h2>
    <form method="post" action="/admin/candidates" enctype="multipart/form-data">
      <label>Name<input name="name" required /></label>
      <label>District / Constituency<input name="district" placeholder="District 1, At-Large, etc." /></label>
      <label>Bio<textarea name="bio" rows="4" placeholder="Short candidate bio"></textarea></label>
      <label>Priorities<textarea name="priorities" rows="3" placeholder="Jobs, healthcare, education..."></textarea></label>
      <label>Display Order<input name="display_order" type="number" value="0" /></label>
      <label>Photo<input name="photo" type="file" accept="image/png,image/jpeg" /></label>
      <button class="btn" type="submit">Add Candidate</button>
    </form>
    <div class="compact-list">
      <% candidates.forEach(c => { %>
        <div><strong><%= c.name %></strong> <span class="muted"><%= c.district %></span>
          <form method="post" action="/admin/candidates/<%= c.id %>/delete" class="inline-form"><button type="submit">Delete</button></form>
        </div>
      <% }) %>
    </div>
  </div>
</section>


<section class="card section-card">
  <h2>Virtual Pay Payments</h2>
  <p class="muted">Pending payments are created when a member starts Virtual Pay checkout. Webhooks can mark them paid automatically, or admins can confirm after verifying the transaction in Virtual Pay.</p>
  <table>
    <thead><tr><th>Date</th><th>Member</th><th>Amount</th><th>Status</th><th>Reference</th><th>Action</th></tr></thead>
    <tbody>
      <% payments.forEach(p => { %>
        <tr>
          <td><%= new Date(p.created_at).toLocaleString() %></td>
          <td><%= p.name %><br><span class="muted"><%= p.email %></span></td>
          <td>$<%= (p.amount/100).toFixed(2) %> <%= p.currency.toUpperCase() %></td>
          <td><%= p.status %></td>
          <td><code><%= p.gateway_reference || p.gateway_transaction_id || 'Manual' %></code></td>
          <td>
            <% if (p.status !== 'paid') { %>
              <form method="post" action="/admin/payments/<%= p.id %>/confirm" class="inline-form">
                <input name="transaction_id" placeholder="Virtual Pay TX ID" />
                <button type="submit">Confirm Paid</button>
              </form>
            <% } else { %>
              <span class="muted">Confirmed</span>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (!payments.length) { %><tr><td colspan="6">No payment records yet.</td></tr><% } %>
    </tbody>
  </table>
</section>

<section class="card section-card">
  <h2>Members</h2>
  <table>
    <thead><tr><th>Name</th><th>Email</th><th>Status</th><th>Change Status</th></tr></thead>
    <tbody>
      <% users.forEach(u => { %>
        <tr>
          <td><%= u.name %></td><td><%= u.email %></td><td><%= u.membership_status %></td>
          <td>
            <form method="post" action="/admin/users/<%= u.id %>/status" class="inline-form">
              <select name="status"><option>active</option><option>inactive</option><option>past_due</option></select>
              <button type="submit">Save</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
<%- include('partials/footer') %>
