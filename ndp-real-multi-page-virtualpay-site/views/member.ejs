<%- include('partials/header') %>
<section class="card section-card">
  <h1>Member Portal</h1>
  <p>Welcome, <strong><%= user.name %></strong>.</p>
  <div class="status-badge <%= user.membership_status %>">Membership: <%= user.membership_status %></div>

  <div class="payment-panel">
    <h2>Activate / Renew Membership</h2>
    <p>Membership is <strong>$20/month</strong>. You will be redirected to Virtual Pay’s secure checkout page when the gateway URL is configured.</p>
    <form method="post" action="/create-virtualpay-payment" class="stacked-form">
      <button class="btn" type="submit">Pay $20 Monthly with Virtual Pay</button>
    </form>
    <p class="muted">If online payment is unavailable, contact the party office and an admin can manually confirm your payment.</p>
  </div>
</section>
<section class="card section-card">
  <h2>Payment History</h2>
  <table>
    <thead><tr><th>Date</th><th>Amount</th><th>Status</th><th>Gateway</th><th>Reference</th></tr></thead>
    <tbody>
      <% payments.forEach(p => { %>
        <tr>
          <td><%= new Date(p.created_at).toLocaleString() %></td>
          <td>$<%= (p.amount/100).toFixed(2) %> <%= p.currency.toUpperCase() %></td>
          <td><%= p.status %></td>
          <td><%= p.gateway || 'virtualpay' %></td>
          <td><code><%= p.gateway_reference || p.gateway_transaction_id || 'Manual' %></code></td>
        </tr>
      <% }) %>
      <% if (!payments.length) { %><tr><td colspan="5">No payments yet.</td></tr><% } %>
    </tbody>
  </table>
</section>
<%- include('partials/footer') %>
