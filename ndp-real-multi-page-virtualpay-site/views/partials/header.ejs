<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= title %> | NDP Membership</title>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
<header class="site-header">
  <a class="brand" href="/">
    <img src="/assets/logo.png" alt="NDP logo" />
    <span>NDP Membership</span>
  </a>
  <button class="menu-toggle" data-menu-toggle>Menu</button>
  <nav class="main-nav" data-menu>
    <a href="/">Home</a>
    <a href="/about">About</a>
    <a href="/events">Events</a>
    <a href="/leaders">Leaders</a>
    <a href="/candidates">Candidates</a>
    <a href="/news">News</a>
    <a href="/manifesto">Manifesto</a>
    <a href="/social">Social</a>
    <% if (user) { %>
      <a href="/member">Member Portal</a>
      <% if (user.role === 'admin') { %><a href="/admin">Admin</a><% } %>
      <form class="inline-form" action="/logout" method="post"><button type="submit">Logout</button></form>
    <% } else { %>
      <a href="/login">Login</a>
      <a class="nav-cta" href="/register">Join</a>
    <% } %>
  </nav>
</header>
<main class="page-shell">
<% if (flash) { %>
  <div class="flash <%= flash.type %>"><%= flash.message %></div>
<% } %>
