<%- include('partials/header') %>
<section class="card section-card">
  <h1>News</h1>
  <div class="news-list">
    <% posts.forEach(post => { %>
      <article>
        <h2><a href="/news/<%= post.slug %>"><%= post.title %></a></h2>
        <p><%= post.excerpt %></p>
        <span class="muted"><%= new Date(post.published_at).toLocaleDateString() %></span>
      </article>
    <% }) %>
  </div>
</section>
<%- include('partials/footer') %>
